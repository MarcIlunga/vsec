{
  "name": "EasyCrypt",
  "scopeName": "source.easycrypt",
  "fileTypes": ["ec", "eca"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#tactics"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.easycrypt",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.easycrypt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.easycrypt",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.easycrypt",
          "match": "\\b(lemma|theorem|axiom|proof|qed|by|require|import|open|module|type|op|pred|theory|end|section|declare|as|export|local|clone|with|remove|rename|equiv|hoare|phoare|lossless|islossless|eager|while|if|then|else|return|var|proc|fun|let|in|match|case|def)\\b"
        }
      ]
    },
    "tactics": {
      "patterns": [
        {
          "name": "keyword.other.tactic.easycrypt", 
          "match": "\\b(trivial|reflexivity|symmetry|transitivity|assumption|exact|apply|rewrite|split|left|right|exists|generalize|clear|intro|intros|move|case|elim|induction|destruct|unfold|fold|simpl|compute|change|replace|assert|cut|have|suffices|wlog|progress|first|last|seq|wp|sp|skip|rnd|swap|cfold|rcondt|rcondf|inline|outline|sim|auto|smt)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.easycrypt",
          "match": "\\b\\d+(\\.\\d*)?([eE][+-]?\\d+)?\\b"
        }
      ]
    }
  }
}