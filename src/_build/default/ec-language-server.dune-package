 (libexec (dm/dm.cmxs lsp/lsp.cmxs sel/sel.cmxs))
 (bin (ecLsp))
 (doc (README.md)))
(library
 (name ec-language-server.dm)
 (kind normal)
 (archives (byte dm/dm.cma) (native dm/dm.cmxa))
 (plugins (byte dm/dm.cma) (native dm/dm.cmxs))
 (native_archives dm/dm.a)
 (requires base ec-language-server.sel ec-language-server.lsp easycrypt.ecLib)
 (main_module_name Dm)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name dm)
     (visibility public)
     (kind alias)
     (source (path Dm) (impl (path dm/dm.ml-gen))))
    (name Dm)
    (modules
     (module
      (obj_name dm__Document)
      (visibility public)
      (source
       (path Document)
       (intf (path dm/document.mli))
       (impl (path dm/document.ml))))
     (module
      (obj_name dm__DocumentManager)
      (visibility public)
      (source
       (path DocumentManager)
       (intf (path dm/documentManager.mli))
       (impl (path dm/documentManager.ml))))
     (module
      (obj_name dm__ExecutionManager)
      (visibility public)
      (source
       (path ExecutionManager)
       (intf (path dm/executionManager.mli))
       (impl (path dm/executionManager.ml))))
     (module
      (obj_name dm__Log)
      (visibility public)
      (source (path Log) (intf (path dm/log.mli)) (impl (path dm/log.ml))))
     (module
      (obj_name dm__PriorityManager)
      (visibility public)
      (source (path PriorityManager) (impl (path dm/priorityManager.ml))))
     (module
      (obj_name dm__RawDocument)
      (visibility public)
      (source
       (path RawDocument)
       (intf (path dm/rawDocument.mli))
       (impl (path dm/rawDocument.ml))))
     (module
      (obj_name dm__Scheduler)
      (visibility public)
      (source
       (path Scheduler)
       (intf (path dm/scheduler.mli))
       (impl (path dm/scheduler.ml))))
     (module
      (obj_name dm__Types)
      (visibility public)
      (source (path Types) (impl (path dm/types.ml))))))
   (wrapped true))))
(library
 (name ec-language-server.lsp)
 (kind normal)
 (archives (byte lsp/lsp.cma) (native lsp/lsp.cmxa))
 (plugins (byte lsp/lsp.cma) (native lsp/lsp.cmxs))
 (native_archives lsp/lsp.a)
 (requires
  sexplib
  yojson
  uri
  ppx_yojson_conv_lib
  ppx_sexp_conv.runtime-lib
  sexplib0)
 (main_module_name Lsp)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name lsp)
     (visibility public)
     (kind alias)
     (source (path Lsp) (impl (path lsp/lsp.ml-gen))))
    (name Lsp)
    (modules
     (module
      (obj_name lsp__ExtProtocol)
      (visibility public)
      (source (path ExtProtocol) (impl (path lsp/extProtocol.ml))))
     (module
      (obj_name lsp__JsonRpc)
      (visibility public)
      (source (path JsonRpc) (impl (path lsp/jsonRpc.ml))))
     (module
      (obj_name lsp__LspData)
      (visibility public)
      (source (path LspData) (impl (path lsp/lspData.ml))))
     (module
      (obj_name lsp__Protocol)
      (visibility public)
      (source (path Protocol) (impl (path lsp/protocol.ml))))))
   (wrapped true))))
(library
 (name ec-language-server.sel)
 (kind normal)
 (archives (byte sel/sel.cma) (native sel/sel.cmxa))
 (plugins (byte sel/sel.cma) (native sel/sel.cmxs))
 (native_archives sel/sel.a)
 (requires unix ppx_deriving.runtime)
 (main_module_name Sel)
 (modes byte native)
 (modules
  (singleton
   (obj_name sel)
   (visibility public)
   (source (path Sel) (intf (path sel/sel.mli)) (impl (path sel/sel.ml))))))
