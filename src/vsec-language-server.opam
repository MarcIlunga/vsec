# Minimal opam file required by dune for public_name declarations
opam-version: "2.0"
name: "vsec-language-server"
version: "0.1.19"
synopsis: "Language Server Protocol implementation for EasyCrypt"
maintainer: "MarcIlunga"
authors: ["The EasyCrypt development team"]
license: "MIT"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.5"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]

