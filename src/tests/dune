(library
  (name tests)
  (libraries base stdio dm lsp easycrypt.ecLib protocol)
  (flags -rectypes)
  (preprocess
    (pps ppx_sexp_conv ppx_inline_test ppx_assert))
  (inline_tests)
  (modules common em_tests test_easycrypt_integration test_execution_engine_safe test_parser_integration_safe))

